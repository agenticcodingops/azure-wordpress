# Example terraform.tfvars
# Copy to terraform.tfvars and fill in your values

project_name = "myproject"
site_name    = "blog"
environment  = "nonprod"
location     = "eastus"

custom_domain = "blog.example.com"

# Azure
azure_subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Cloudflare
cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_domain     = "example.com"
cloudflare_subdomain  = "blog"
# Enable after configuring the edge transform rule. Keep this value in a secret store.
# cdn_origin_header_name   = "x_azure_fdid"
# cdn_origin_header_values = ["xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"]

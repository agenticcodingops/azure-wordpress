{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hand-kept pin freshness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["pins"],
  "properties": {
    "$schema": {"type": "string"},
    "pins": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/pin"}
    }
  },
  "$defs": {
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "locations", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "mirrors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "locations"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "locations": {"$ref": "#/$defs/pin/properties/locations"}
            }
          }
        },
        "locations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["file", "pattern"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "pattern": "\\(\\?P<value>"}
            }
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "repo"],
              "properties": {
                "type": {"enum": ["github_releases", "github_tags"]},
                "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
                "tag_pattern": {"type": "string", "pattern": "\\(\\?P<version>"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "package"],
              "properties": {
                "type": {"const": "pypi"},
                "package": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
              }
            }
          ]
        },
        "policy": {"enum": ["exact", "minimum", "manual"]},
        "precondition": {"type": "string", "minLength": 1},
        "review_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"policy": {"const": "manual"}}, "required": ["policy"]},
        "then": {"required": ["review_reason"]}
      }]
    }
  }
}

#!/bin/sh
# Rejects a contributor-credit trailer that names an AI assistant, and any author or
# committer that is an AI assistant or is not exactly the configured git identity.
# Policy: AGENTS.md.

root=$(git rev-parse --show-toplevel) || exit 1
for f in branding-guard.sh guard-helpers.sh; do
    [ -f "$root/.githooks/$f" ] || { printf 'BLOCKED: .githooks/%s is missing; refusing to commit without it.\n' "$f" >&2; exit 1; }
done
. "$root/.githooks/branding-guard.sh"
. "$root/.githooks/guard-helpers.sh"

ident() { git var "$1" | sed 's/ [0-9][0-9]* [-+][0-9][0-9][0-9][0-9]$//'; }   # "Name <email>"
email_of() { sed -n 's/^.*<\([^>]*\)>.*$/\1/p'; }

fail=0
attribution_scan "commit message" <"$1" || fail=1

# Local commits must be the configured identity, exactly: no --author or GIT_AUTHOR_*
# override can make a local commit claim another identity.
want="$(git config user.name) <$(git config user.email)>"
for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    role=$(printf '%s' "$var" | sed 's/^GIT_\(.*\)_IDENT$/\1/' | tr '[:upper:]' '[:lower:]')
    got=$(ident "$var")
    if [ "$got" != "$want" ]; then
        printf 'BLOCKED: %s "%s" is not the configured identity "%s".\n' "$role" "$got" "$want" >&2
        fail=1
    fi
    identity_check "$(printf '%s' "$got" | email_of)" "$role" "this commit" || fail=1
    name_check "$(printf '%s' "$got" | sed 's/ <[^>]*>$//')" "$role" "this commit" || fail=1
done

if [ "$fail" -ne 0 ]; then
    printf '\nCommit rejected. Remove the AI attribution trailer, or drop the identity override; do not use --no-verify.\n' >&2
    exit 1
fi
exit 0

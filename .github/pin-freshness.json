{
  "$schema": "https://raw.githubusercontent.com/agenticcodingops/auto-code-scanning/179f7e83fb8845aac3fc0f7c01ac0d129e4dfa00/schemas/pin-freshness.schema.json",
  "pins": [
    {
      "id": "terraform-cli",
      "locations": [
        {
          "file": ".terraform-version",
          "pattern": "^(?P<value>\\d+\\.\\d+\\.\\d+)\\s*$"
        },
        {
          "file": ".github/workflows/validate.yml",
          "pattern": "TERRAFORM_VERSION:\\s*[\\\"\\x27]?(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "Terraform (?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "Terraform v(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CONTRIBUTING.md",
          "pattern": "Terraform (?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": ".gemini/styleguide.md",
          "pattern": "pinned to Terraform `(?P<value>\\d+\\.\\d+\\.\\d+)"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "hashicorp/terraform"
      },
      "precondition": "Terraform 1.17.1 exactly, as the workflow asserts"
    },
    {
      "id": "terraform-docs",
      "locations": [
        {
          "file": "CLAUDE.md",
          "pattern": "terraform-docs(?:` \\(v| )(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CONTRIBUTING.md",
          "pattern": "terraform-docs(?:` \\(v| )(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": ".gemini/styleguide.md",
          "pattern": "terraform-docs(?:` \\(v| )(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "AGENTS.md",
          "pattern": "terraform-docs READMEs \\((?P<value>\\d+\\.\\d+\\.\\d+)"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "terraform-docs/terraform-docs"
      },
      "precondition": "Do NOT leave `.terraform/` or `.terraform.lock.hcl` in module directories when running terraform-docs. CI runs the version the docs action bundles; no release of the action bundles a newer one (checked 2026-11-13), and READMEs generated by 0.22.0 or later fail its diff check"
    },
    {
      "id": "validation-checkov-guidance",
      "locations": [
        {
          "file": "CLAUDE.md",
          "pattern": "(?:^#.*?Checkov |against the Checkov job\\x27s )(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CONTRIBUTING.md",
          "pattern": "Checkov (?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "checkov==(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CONTRIBUTING.md",
          "pattern": "checkov==(?P<value>\\d+\\.\\d+\\.\\d+)"
        }
      ],
      "source": {
        "type": "pypi",
        "package": "checkov"
      },
      "precondition": "re-read action.yml rather than trusting this number."
    },
    {
      "id": "validation-checkov-action-mirror",
      "locations": [
        {
          "file": ".github/workflows/validate.yml",
          "pattern": "bridgecrewio/checkov-action@v(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "(?:bridgecrewio/checkov-action v|v)(?P<value>12\\.\\d+\\.\\d+)"
        }
      ],
      "source": {
        "type": "github_tags",
        "repo": "bridgecrewio/checkov-action"
      },
      "precondition": "re-read action.yml rather than trusting this number."
    },
    {
      "id": "semgrep-container-version",
      "locations": [
        {
          "file": ".github/workflows/semgrep.yml",
          "pattern": "semgrep (?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "semgrep (?P<value>\\d+\\.\\d+\\.\\d+)"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "semgrep/semgrep"
      },
      "precondition": "renew the digest deliberately."
    },
    {
      "id": "semgrep-container-digest",
      "locations": [
        {
          "file": ".github/workflows/semgrep.yml",
          "pattern": "image: semgrep/semgrep@(?P<value>sha256:[0-9a-f]{64})"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "semgrep/semgrep"
      },
      "policy": "manual",
      "review_reason": "Digest-pinned container: verify the publisher image for the chosen version; the release API does not authenticate container digests.",
      "precondition": "renew the digest deliberately."
    },
    {
      "id": "tflint-ruleset-terraform",
      "locations": [
        {
          "file": ".tflint.hcl",
          "pattern": "(?s:plugin \"terraform\" \\{.*?version\\s*=\\s*\"(?P<value>\\d+\\.\\d+\\.\\d+)\")"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "terraform-linters/tflint-ruleset-terraform"
      },
      "precondition": "CI uses the canonical copy; update this when terraform-scan.yml's ref changes."
    },
    {
      "id": "tflint-ruleset-azurerm",
      "locations": [
        {
          "file": ".tflint.hcl",
          "pattern": "(?s:plugin \"azurerm\" \\{.*?version\\s*=\\s*\"(?P<value>\\d+\\.\\d+\\.\\d+)\")"
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "terraform-linters/tflint-ruleset-azurerm"
      },
      "precondition": "CI uses the canonical copy; update this when terraform-scan.yml's ref changes."
    },
    {
      "id": "scanning-platform",
      "locations": [
        {
          "file": ".github/workflows/terraform-scan.yml",
          "pattern": "(?:scanning-repo-ref|scanning_repo_ref):\\s*\"?(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/terraform-scan.yml",
          "pattern": "auto-code-scanning/[^\\s@]+@(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/terraform-scan.yml",
          "pattern": "(?:auto-code-scanning/[^\\n]+|scanning[-_]repo[-_]ref:[^\\n]+)# (?P<value>v\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": ".github/workflows/autonomous-fix.yml",
          "pattern": "(?:scanning-repo-ref|scanning_repo_ref):\\s*\"?(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/autonomous-fix.yml",
          "pattern": "auto-code-scanning/[^\\s@]+@(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/autonomous-fix.yml",
          "pattern": "(?:auto-code-scanning/[^\\n]+|scanning[-_]repo[-_]ref:[^\\n]+)# (?P<value>v\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "scan-config.yaml",
          "pattern": "the scan and fix loop pin (?P<value>v\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "lefthook.yml",
          "pattern": "auto-code-scanning @ (?P<value>v\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "(?:workflow at |pinned by SHA \\(|together at |vendored )(?P<value>v3\\.\\d+\\.\\d+)"
        },
        {
          "file": "CONTRIBUTING.md",
          "pattern": "The (?P<value>v3\\.\\d+\\.\\d+) push hooks"
        }
      ],
      "source": {
        "type": "github_tags",
        "repo": "agenticcodingops/auto-code-scanning"
      },
      "precondition": "Move the `uses:` pin and `scanning-repo-ref` together"
    },
    {
      "id": "freshness-platform",
      "locations": [
        {
          "file": ".github/workflows/pin-freshness.yml",
          "pattern": "auto-code-scanning/[^\\s@]+@(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/pin-freshness.yml",
          "pattern": "scanning-repo-ref: (?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/pin-freshness.yml",
          "pattern": "# (?P<value>v\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": ".github/pin-freshness.json",
          "pattern": "raw\\.githubusercontent\\.com/agenticcodingops/auto-code-scanning/(?P<value>[0-9a-f]{40})/schemas"
        }
      ],
      "source": {
        "type": "github_tags",
        "repo": "agenticcodingops/auto-code-scanning"
      }
    },
    {
      "id": "review-action",
      "locations": [
        {
          "file": ".github/workflows/claude-code-review.yml",
          "pattern": "anthropics/claude-code-action@(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/claude.yml",
          "pattern": "anthropics/claude-code-action@(?P<value>[0-9a-f]{40})"
        },
        {
          "file": ".github/workflows/claude-code-review.yml",
          "pattern": "# (?P<value>v1\\.0\\.\\d+)"
        },
        {
          "file": ".github/workflows/claude.yml",
          "pattern": "# (?P<value>v1\\.0\\.\\d+)"
        }
      ],
      "source": {
        "type": "github_tags",
        "repo": "anthropics/claude-code-action"
      },
      "precondition": "Re-measure with that probe before loosening the guard or\nbumping the action pin"
    },
    {
      "id": "fix-loop-action",
      "locations": [
        {
          "file": "scan-config.yaml",
          "pattern": "anthropics/claude-code-action@(?P<value>[0-9a-f]{40})"
        }
      ],
      "source": {
        "type": "github_tags",
        "repo": "anthropics/claude-code-action"
      },
      "precondition": "Centralized, SHA-pinned claude-code-action (>= v1.0.93, CVE-2025-66032)."
    },
    {
      "id": "python-pyyaml",
      "locations": [
        {
          "file": ".github/workflows/validate.yml",
          "pattern": "PyYAML==(?P<value>\\d+\\.\\d+\\.\\d+)"

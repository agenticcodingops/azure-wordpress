    {
      "id": "review-model",
      "locations": [
        {
          "file": ".github/scripts/gemini_review.py",
          "pattern": "DEFAULT_MODEL = \"(?P<value>[^\\\"]+)\""
        }
      ],
      "source": {
        "type": "github_releases",
        "repo": "googleapis/python-genai"
      },
      "policy": "manual",
      "review_reason": "Model identifier is a service selection; verify its availability and API behavior against the provider catalog."
    },
    {
      "id": "wordpress-image-series",
      "locations": [
        {
          "file": "modules/app-service/variables.tf",

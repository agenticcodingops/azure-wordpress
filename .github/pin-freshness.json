        {
          "file": "CONTRIBUTING.md",
          "pattern": "PyYAML==(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": "CLAUDE.md",
          "pattern": "PyYAML==(?P<value>\\d+\\.\\d+\\.\\d+)"
        },
        {
          "file": ".github/workflows/terraform-scan.yml",
